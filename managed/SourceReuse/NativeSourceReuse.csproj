<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="NativeSourceReuse"/>
    <PackageReference Include="BepInEx.Core" Version="6.0.0-be.785"/>
    <Compile Include="$(EHRSourceRoot)/Modules/OptionItem/ValueRule.cs" Link="Upstream/ValueRule.cs"/>
    <Compile Include="$(EHRSourceRoot)/Patches/ServerVersionPatch.cs" Link="Upstream/ServerVersionPatch.cs"/>
  </ItemGroup>
  <Target Name="RequirePinnedSource" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(EHRSourceRoot)/Patches/ServerVersionPatch.cs')" Text="Pass -p:EHRSourceRoot=/path/to/verified/EHR/source. No game assemblies are required."/>
  </Target>
</Project>
