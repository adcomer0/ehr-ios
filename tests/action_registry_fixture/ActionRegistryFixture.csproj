<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <PublishAot>true</PublishAot><IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup><Compile Include="../../managed/SourceReuse/Facades/ActionRuntime.cs" Link="ActionRuntime.cs"/></ItemGroup>
</Project>
