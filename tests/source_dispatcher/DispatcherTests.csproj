<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable><LangVersion>preview</LangVersion><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <FixtureGeneratedDirectory Condition="'$(FixtureGeneratedDirectory)' == ''">Generated</FixtureGeneratedDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" /><Compile Include="$(FixtureGeneratedDirectory)/Fixture.cs" />
    <Compile Include="$(FixtureGeneratedDirectory)/EHRStaticPatchCatalog.g.cs" /><Compile Include="../../managed/SourcePort/StaticPatchRuntime.cs" />
  <Compile Include="../../managed/SourcePort/EHRSourceAccountPolicy.cs" Link="EHRSourceAccountPolicy.cs"/></ItemGroup>
</Project>
